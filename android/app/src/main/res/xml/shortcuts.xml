<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the SafeHer icon: opens the native Emergency Card directly, even with no network. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="emergency_card"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_card_short"
        android:shortcutLongLabel="@string/title_emergency_card">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.safeher.app"
            android:targetClass="com.safeher.app.EmergencyCardActivity" />
    </shortcut>
</shortcuts>
