<?xml version="1.0" encoding="utf-8"?>
<!-- One emergency-contact row (RelativeLayout): text on the left, Call button on the right. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/card_surface"
    android:padding="12dp">

    <Button
        android:id="@+id/contactCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="@string/card_call" />

    <TextView
        android:id="@+id/contactName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/contactCall"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/card_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/contactDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/contactName"
        android:layout_toStartOf="@id/contactCall"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/card_muted"
        android:textSize="14sp" />
</RelativeLayout>
