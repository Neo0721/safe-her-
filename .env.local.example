# SafeHer Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local (it contains your Firebase Admin private key).

# --- Application ---
NEXT_PUBLIC_APP_NAME=SafeHer
NEXT_PUBLIC_EMERGENCY_NUMBER=112
NEXT_PUBLIC_LOCATION_UPDATE_INTERVAL_MS=5000
NEXT_PUBLIC_LOCATION_MIN_DISTANCE_METERS=5
# Seconds a real SOS must run before it can be ended (guards against panicked mis-taps). Drills have no delay.
NEXT_PUBLIC_SOS_CANCEL_DELAY_SECONDS=10

# --- Server address the Android app loads (read by `npx cap sync android`) ---
# The Android app is a WebView on your running Next.js server (API routes, SQLite and Firebase Admin live there).
#   Android emulator -> your computer:  http://10.0.2.2:3000
#   Real phone on the same Wi-Fi:       http://<your-computer-LAN-IP>:3000   (run: npm run dev -- -H 0.0.0.0)
#   Production:                         https://your-domain.example         (HTTPS is required for release builds)
# After changing it, run: npx cap sync android
NEXT_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# --- Firebase Client SDK (identity only) ---
# Firebase Console -> Project Settings -> General -> Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- Firebase Admin SDK (SERVER ONLY: never exposed to the browser or the Android app) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# --- Optional ---
# Max API requests per client per minute (default 600).
# RATE_LIMIT_PER_MINUTE=600
# Only needed if a client is served from a different origin than the API (comma-separated).
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Use a different SQLite file (e.g. for tests). Default: ./data/safeher.db
# SAFEHER_DB_PATH=/tmp/safeher-test.db

# --- Local testing only (ignored when NODE_ENV=production) ---
# Test signup/login without touching your real Firebase users. Run:
#   npx firebase-tools emulators:start --only auth --project <your-project-id>
# then start the dev server with:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099   (10.0.2.2 = your computer, as seen from the Android emulator)
